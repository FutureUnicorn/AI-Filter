# AF-11 local-only environment values. Copy to .env.local; never commit that file.
APP_ENV=development
DEPLOYMENT_COMMIT_SHA=local

# Local Postgres. These credentials are intentionally development-only.
DATABASE_URL=postgresql://signal_audit_local:local-only-password@localhost:5432/signal_audit_local
POSTGRES_DB=signal_audit_local
POSTGRES_USER=signal_audit_local
POSTGRES_PASSWORD=local-only-password
DATABASE_SCHEMA=public

# Local S3-compatible storage (MinIO). These are not cloud credentials.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=signal-audit-development
STORAGE_ACCESS_KEY_ID=signal-audit-local
STORAGE_SECRET_ACCESS_KEY=local-only-storage-password
STORAGE_FORCE_PATH_STYLE=true

# Runtime ports.
WEB_PORT=3000
WORKER_PORT=3001

# Server-side monitoring. Empty DSNs disable Sentry in development/test.
# Hosted compose maps the web/worker values to each service's SENTRY_DSN.
# Set both DSNs to the same value when the Sentry account cannot provide
# separate projects; the low-cardinality service tag still separates them.
SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_WORKER_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ORG=
SENTRY_WEB_PROJECT=
SENTRY_WORKER_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ALERT_ERROR_RATE_THRESHOLD_PERCENT=
SENTRY_ALERT_WORKER_ERROR_COUNT_THRESHOLD=
SENTRY_ALERT_EVALUATION_WINDOW_SECONDS=
SENTRY_ALERT_MIN_EVENT_VOLUME=
SENTRY_ALERT_P95_THRESHOLDS_MS=
SENTRY_ALERT_TOKEN_BUDGET_EVENT_THRESHOLD=
# Keep false until a synthetic staging drill verifies the AF-102 producer.
SENTRY_ALERT_TOKEN_BUDGET_PRODUCER_READY=false
SENTRY_ALERT_WORKFLOW_IDS=
SENTRY_ALERT_OWNER=

# Session signing. AF-23 signs and verifies the session cookie with this on
# every authenticated request, so the web server refuses to start without it
# (apps/web/src/instrumentation.ts). Must be at least 32 characters. Generate
# your own: `openssl rand -hex 32`. This value is development-only.
SESSION_SECRET=local-only-session-secret-at-least-32-chars

# The origin emailed magic links are built from. Optional locally, where it
# falls back to http://localhost:${WEB_PORT}, and REQUIRED for staging and
# production: a link built from the incoming request host is attacker-steerable,
# so a hosted deployment fails to boot rather than trusting it.
PUBLIC_APP_ORIGIN=

# Magic-link delivery. All three empty locally, which selects the console
# sender and prints the link to stderr. A hosted environment has no terminal
# for anyone to read, so it requires all three and fails to boot without them.
MAGIC_LINK_EMAIL_ENDPOINT=
MAGIC_LINK_EMAIL_API_KEY=
MAGIC_LINK_EMAIL_FROM=

# Durable evidence extraction. Disabled keeps local/test credential-free.
WORKER_PROCESSING_ENABLED=false
# Deployment/instance label prefix; each process appends a unique boot ID.
WORKER_INSTANCE_ID=
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_LEASE_DURATION_MS=60000
WORKER_RETRY_BASE_DELAY_MS=5000
WORKER_MAX_ATTEMPTS=3

# Provider and token-budget configuration are required only when processing is enabled.
# Never place a real production key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_ESCALATION_MODEL=gpt-5.6
INFERENCE_MAX_TOKENS_PER_PERIOD=
INFERENCE_ALERT_THRESHOLD_RATIO=
INFERENCE_BUDGET_PERIOD=
INFERENCE_ESTIMATED_OUTPUT_TOKENS=2000
