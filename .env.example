# AF-11 local-only environment values. Copy to .env.local; never commit that file.
APP_ENV=development
DEPLOYMENT_COMMIT_SHA=local

# Local Postgres. These credentials are intentionally development-only.
DATABASE_URL=postgresql://signal_audit_local:local-only-password@localhost:5432/signal_audit_local
POSTGRES_DB=signal_audit_local
POSTGRES_USER=signal_audit_local
POSTGRES_PASSWORD=local-only-password
DATABASE_SCHEMA=public

# Local S3-compatible storage (MinIO). These are not cloud credentials.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=signal-audit-development
STORAGE_ACCESS_KEY_ID=signal-audit-local
STORAGE_SECRET_ACCESS_KEY=local-only-storage-password
STORAGE_FORCE_PATH_STYLE=true

# Runtime ports.
WEB_PORT=3000
WORKER_PORT=3001

# Session signing. AF-23 signs and verifies the session cookie with this on
# every authenticated request, so the web server refuses to start without it
# (apps/web/src/instrumentation.ts). Must be at least 32 characters. Generate
# your own: `openssl rand -hex 32`. This value is development-only.
SESSION_SECRET=local-only-session-secret-at-least-32-chars

# The origin emailed magic links are built from. Optional locally, where it
# falls back to http://localhost:${WEB_PORT}, and REQUIRED for staging and
# production: a link built from the incoming request host is attacker-steerable,
# so a hosted deployment fails to boot rather than trusting it.
PUBLIC_APP_ORIGIN=

# Magic-link delivery. All three empty locally, which selects the console
# sender and prints the link to stderr. A hosted environment has no terminal
# for anyone to read, so it requires all three and fails to boot without them.
MAGIC_LINK_EMAIL_ENDPOINT=
MAGIC_LINK_EMAIL_API_KEY=
MAGIC_LINK_EMAIL_FROM=

# Optional concierge-only AI configuration. Never place a real production key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
