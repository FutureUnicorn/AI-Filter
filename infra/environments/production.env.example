# AF-11 production is empty infrastructure validation only until the paid-pilot gate passes.
AF11_ENABLE_HOSTED_ENVIRONMENTS=true
PRODUCTION_VALIDATION_ONLY=true
APP_ENV=production
DEPLOYMENT_COMMIT_SHA=<exact-green-main-sha>
POSTGRES_USER=<production-only-deploy-identity>
POSTGRES_PASSWORD=<production-secret-manager-reference>
STORAGE_ACCESS_KEY_ID=<production-only-storage-identity>
STORAGE_SECRET_ACCESS_KEY=<production-secret-manager-reference>
COST_CONTROL_REFERENCE=<production-budget-cap-and-alert-reference>
COST_CONTROL_OWNER=<named-production-owner>
SENTRY_WEB_DSN=<production-web-project-dsn-secret-reference>
SENTRY_WORKER_DSN=<production-worker-project-dsn-secret-reference>
SENTRY_TRACES_SAMPLE_RATE=<approved-production-rate-between-0-and-1>
WORKER_PROCESSING_ENABLED=false
WORKER_MAX_ATTEMPTS=3
ADMIN_AUDIT_REFERENCE=<provider-audit-log-reference>
ADMIN_ROLE_ALLOWLIST=<named-production-admin-role>
BACKUP_ENABLED=<true-after-af68-controls-are-approved>
BACKUP_ENDPOINT=<https-s3-compatible-backup-origin>
BACKUP_REGION=<backup-provider-region>
BACKUP_BUCKET=<dedicated-production-backup-bucket>
BACKUP_ACCESS_KEY_ID=<production-backup-only-identity>
BACKUP_SECRET_ACCESS_KEY=<production-backup-secret-manager-reference>
BACKUP_INTERVAL_SECONDS=<approved-production-backup-interval>
BACKUP_RETENTION_DAYS=<approved-production-retention-window>
BACKUP_PATH_STYLE=<auto-on-or-off>
BACKUP_CONTROL_OWNER=<named-owner-or-team>
BACKUP_ENCRYPTION_REFERENCE=<provider-sse-s3-control-reference>
