# Values are names/categories only. Store real values in the GitHub staging environment.
AF11_ENABLE_HOSTED_ENVIRONMENTS=true
APP_ENV=staging
DEPLOYMENT_COMMIT_SHA=<verified-develop-sha>
POSTGRES_USER=<staging-only-service-identity>
POSTGRES_PASSWORD=<staging-secret-manager-reference>
STORAGE_ACCESS_KEY_ID=<staging-only-storage-identity>
STORAGE_SECRET_ACCESS_KEY=<staging-secret-manager-reference>
COST_CONTROL_REFERENCE=<provider-budget-or-alert-reference>
COST_CONTROL_OWNER=<named-owner-or-team>
SENTRY_WEB_DSN=<staging-web-project-dsn-secret-reference>
SENTRY_WORKER_DSN=<staging-worker-project-dsn-secret-reference>
SENTRY_TRACES_SAMPLE_RATE=<approved-staging-rate-between-0-and-1>
WORKER_PROCESSING_ENABLED=true
WORKER_INSTANCE_ID=<staging-worker-label-prefix>
WORKER_CONCURRENCY=<approved-staging-concurrency>
WORKER_MAX_ATTEMPTS=<approved-bounded-attempt-count>
OPENAI_API_KEY=<staging-provider-key-secret-reference>
OPENAI_MODEL=<approved-default-model>
OPENAI_ESCALATION_MODEL=<approved-escalation-model>
INFERENCE_MAX_TOKENS_PER_PERIOD=<approved-token-cap>
INFERENCE_ALERT_THRESHOLD_RATIO=<approved-warning-ratio>
INFERENCE_BUDGET_PERIOD=<day-or-month>
ADMIN_AUDIT_REFERENCE=<provider-audit-log-reference>
ADMIN_ROLE_ALLOWLIST=<named-staging-admin-role>
BACKUP_ENABLED=<true-after-af68-controls-are-approved>
BACKUP_ENDPOINT=<https-s3-compatible-backup-origin>
BACKUP_REGION=<backup-provider-region>
BACKUP_BUCKET=<dedicated-staging-backup-bucket>
BACKUP_ACCESS_KEY_ID=<staging-backup-only-identity>
BACKUP_SECRET_ACCESS_KEY=<staging-backup-secret-manager-reference>
BACKUP_INTERVAL_SECONDS=<approved-staging-backup-interval>
BACKUP_RETENTION_DAYS=<approved-staging-retention-window>
BACKUP_PATH_STYLE=<auto-on-or-off>
BACKUP_CONTROL_OWNER=<named-owner-or-team>
BACKUP_ENCRYPTION_REFERENCE=<provider-sse-s3-control-reference>
