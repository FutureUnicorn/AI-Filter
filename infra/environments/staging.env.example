# Values are names/categories only. Store real values in the GitHub staging environment.
AF11_ENABLE_HOSTED_ENVIRONMENTS=true
APP_ENV=staging
DEPLOYMENT_COMMIT_SHA=<verified-develop-sha>
POSTGRES_USER=<staging-only-service-identity>
POSTGRES_PASSWORD=<staging-secret-manager-reference>
STORAGE_ACCESS_KEY_ID=<staging-only-storage-identity>
STORAGE_SECRET_ACCESS_KEY=<staging-secret-manager-reference>
COST_CONTROL_REFERENCE=<provider-budget-or-alert-reference>
COST_CONTROL_OWNER=<named-owner-or-team>
ADMIN_AUDIT_REFERENCE=<provider-audit-log-reference>
ADMIN_ROLE_ALLOWLIST=<named-staging-admin-role>
